# 由 nginx 官方镜像在启动时用 envsubst 渲染（${API_UPSTREAM} 等变量）。
# 对模型调用接口限流，防止链接外泄后额度被刷光。
limit_req_zone $binary_remote_addr zone=llm:10m rate=${LLM_RATE_LIMIT};

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 50m;

    include /etc/nginx/conf.d/auth.inc;

    root /usr/share/nginx/html;
    index index.html;

    # 健康检查不加密码，方便监控
    location = /api/health {
        auth_basic off;
        proxy_pass http://${API_UPSTREAM};
    }

    # 调用大模型的接口：SSE 流式输出 + 限流
    location ~ ^/api/(chat|starmap/|practice/|adaptive/nodes/|kb/(mermaid|quiz|code|presentation|courses/[^/]+/(build|materials))) {
        limit_req zone=llm burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # WebSocket：智能体控制台、任务进度
    location ~ ^/(api/console/ws|ws/) {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 600s;
    }

    # 评审不需要后端交互式文档，避免暴露全部接口
    location ~ ^/(docs|redoc|openapi\.json) {
        return 404;
    }

    # 前端单页应用路由
    location / {
        try_files $uri $uri/ /index.html;
    }
}

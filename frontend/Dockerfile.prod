# 参赛 / 公网部署用：直接使用本地预编译好的静态前端 dist，由 Nginx 统一提供页面并反向代理后端。
FROM nginx:1.27-alpine
RUN apk add --no-cache openssl
COPY dist /usr/share/nginx/html
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/40-basic-auth.sh /docker-entrypoint.d/40-basic-auth.sh
RUN sed -i 's/\r$//' /docker-entrypoint.d/40-basic-auth.sh && chmod +x /docker-entrypoint.d/40-basic-auth.sh
EXPOSE 80

# ============================================
# EduWeave AI - 环境变量模板
# ============================================
# 使用方法：
#   cp .env.example .env   # 然后填入你自己的密钥
#
# 本文件只包含变量名与示例值，绝不要把真实密钥提交到版本库。
# ============================================

# ---------- Backend ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# ---------- Frontend ----------
# Vite 读取的前端变量（放在 frontend/.env.local）
VITE_API_URL=http://localhost:8000

# ---------- 模型服务：讯飞星火 X2 ----------
# 百炼本机运行请改用 bailian.env.example → .env.bailian，并带 --env-file 启动。
# LLM_PROVIDER=bailian 时使用以下三项；xunfei 时使用下方原讯飞配置。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=deepseek-v4.1-flash-1017

MODEL_PROVIDER=xunfei
LLM_PROVIDER=xunfei

# 从 https://console.xfyun.cn 获取
XUNFEI_SPARK_APP_ID=<your_app_id>
XUNFEI_SPARK_API_KEY=<your_api_key>
XUNFEI_SPARK_API_SECRET=<your_api_secret>

XUNFEI_SPARK_TRANSPORT=ws
XUNFEI_SPARK_WS_ENDPOINT=wss://spark-api.xf-yun.com/x2
XUNFEI_SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1
XUNFEI_SPARK_MODEL=4.0Ultra
XUNFEI_SPARK_DOMAIN=spark-x
XUNFEI_SPARK_TIMEOUT_SECONDS=90
XUNFEI_SPARK_READ_TIMEOUT_SECONDS=30
XUNFEI_SPARK_MAX_TOKENS=2048
XUNFEI_SPARK_TOP_K=5
XUNFEI_SPARK_THINKING=disabled
XUNFEI_SPARK_UID=eduweave-demo

# profile 抽取模式：llm（真实模型）| rule（规则兜底）
PROFILE_EXTRACTION_MODE=llm

# ---------- TTS：讯飞超拟人流式语音 ----------
TTS_PROVIDER=xunfei_oral
XUNFEI_TTS_APP_ID=<your_app_id>
XUNFEI_TTS_API_KEY=<your_api_key>
XUNFEI_TTS_API_SECRET=<your_api_secret>
XUNFEI_TTS_ENDPOINT=wss://cbm01.cn-huabei-1.xf-yun.com/v1/private/<your_endpoint>
XUNFEI_TTS_VOICE=x6_huanlemianbao_pro
XUNFEI_TTS_AUE=lame
XUNFEI_TTS_ORAL_LEVEL=mid

# ---------- 知识库：Dify ----------
# 用于同步 Dify 知识库（datasets）。留空则跳过同步。
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=<your_dify_dataset_api_key>

# ---------- 基础设施（Docker Compose） ----------
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/eduweave

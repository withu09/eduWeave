# EduWeave 本机配置：北京地域，百炼通用模型 API。
# 复制为 .env.bailian，再填写自己的通用 API Key。
# 此模板中的变量已由模型接入代码和 Docker Compose 读取。
EDUWEAVE_ENV_FILE=.env.bailian
BACKEND_DOCKERFILE=Dockerfile.local
WORKER_DOCKERFILE=Dockerfile.local
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
LLM_PROVIDER=bailian
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=deepseek-v4.1-flash-1017

# 首次启动创建示例课程；已有课程时不会重复创建。
SEED_DEMO_DATA=true
# 向量示例入库会下载嵌入模型，首次体验先跳过，不影响星图和学习对话。
SEED_VECTOR_KB=false

# 可选服务。未配置 Dify 时跳过同步；语音朗读仍需讯飞语音服务。
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_INDEXING_TECHNIQUE=economy
XUNFEI_TTS_APP_ID=
XUNFEI_TTS_API_KEY=
XUNFEI_TTS_API_SECRET=
VITE_API_URL=http://localhost:8000

# —— 参赛 / 公网部署（docker-compose.prod.yml）使用 ——
# 评审专家访问站点时输入的账号和密码，提交作品时一并填写到大赛平台。
# 请使用不含个人姓名、学校信息的账号名，例如 reviewer。
REVIEW_USER=reviewer
REVIEW_PASSWORD=
# 网关对外端口（默认 80）与模型接口限流（每个 IP 每分钟请求数）
GATEWAY_PORT=80
LLM_RATE_LIMIT=20r/m
